# ============================================
# PlayFab Configuration
# ============================================
# Get your Title ID from: https://developer.playfab.com/
# Settings → Title Settings → Title ID
REACT_APP_PLAYFAB_TITLE_ID=YOUR_TITLE_ID_HERE

# Example: REACT_APP_PLAYFAB_TITLE_ID=ABC12


# ============================================
# Azure Application Insights Configuration
# ============================================
# Get your Instrumentation Key from: https://portal.azure.com/
# Create Application Insights resource → Copy Instrumentation Key from Overview

REACT_APP_APPINSIGHTS_KEY=YOUR_INSTRUMENTATION_KEY_HERE

# Example: REACT_APP_APPINSIGHTS_KEY=12345678-1234-1234-1234-123456789012


# ============================================
# Optional: Connection String (Alternative to Instrumentation Key)
# ============================================
# REACT_APP_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=xxx


# ============================================
# Development Settings
# ============================================
# Enable debug mode for local development
NODE_ENV=development

# Vite dev server port
PORT=5173

